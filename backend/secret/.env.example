# ============================================
# Example Environment Variables
# ============================================
# generated by Forge
# DO NOT commit this file to version control
# ============================================

# ============================================
# Application Configuration
# ============================================
APP_NAME="light-rain"
APP_VERSION="1.0.0"
APP_DESCRIPTION="light-rain API"

# ============================================
# Database Configuration (MySQL)
# ============================================
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dbname

# Connection Pool Configuration
ECHO=false
POOL_PRE_PING=true
POOL_TIMEOUT=30
POOL_SIZE=6
POOL_MAX_OVERFLOW=2

# ============================================
# Authentication Configuration
# ============================================
JWT_SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRATION=1800
JWT_REFRESH_TOKEN_EXPIRATION=86400
JWT_ISSUER=demo
JWT_AUDIENCE=demo_users

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password-here
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_SSL_CERT_REQS=required
EMAIL_TIMEOUT=30
EMAIL_EXPIRATION=3600

# Email From Configuration
EMAIL_FROM_NAME=Your App Name
EMAIL_FROM_EMAIL=your-email@example.com

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=

# ============================================
# Redis Configuration
# ============================================
REDIS_CONNECTION_URL=redis://localhost:6379
REDIS_POOL_SIZE=5
REDIS_SOCKET_TIMEOUT=10
REDIS_DEFAULT_TTL=3600

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_RESULT_EXPIRES=3600

# Task routing (JSON format)
CELERY_TASK_ROUTES={}

# Periodic tasks schedule (configured in code)
# CELERY_BEAT_SCHEDULE is configured in app/core/celery.py

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_TO_CONSOLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_ROTATION=1 day
LOG_RETENTION_PERIOD=7 days

# ============================================
# LLM & Tools Configuration
# ============================================
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
USER_LLM_KEY_ENCRYPTION_KEY=base64-encoded-32-byte-key
WEATHER_API_KEY=your_weatherapi_key_here
SERPER_API_KEY=your_serper_api_key_here
TEXT_TO_IMAGE_MODEL=qwen-image-plus
TEXT_TO_IMAGE_SIZE=1024*1024
# ============================================
# AI News Configuration
# ============================================
AI_NEWS_QUERY="人工智能 OR AI OR 大模型 OR AIGC OR OpenAI OR Claude OR Gemini"
AI_NEWS_GL=cn
AI_NEWS_HL=zh-cn
AI_NEWS_TBS=qdr:w
AI_NEWS_CACHE_TTL_SECONDS=900
AI_NEWS_DEFAULT_LIMIT=10
# ============================================
# Usage & Billing Configuration
# ============================================
USAGE_DEFAULT_MONTHLY_BUDGET_USD=20
USAGE_DEFAULT_DAILY_REQUEST_LIMIT=200
LLM_PRICING_JSON='{"qwen3-max":{"prompt_per_1k":0.01,"completion_per_1k":0.03}}'

